{
  "name": "jord-jd/exiguous-ecommerce",
  "description": "Exiguous Ecommerce is a super simple ecommerce library, that uses flat files and takes a very minimalistic approach.",
  "license": "LGPL-3.0-only",
  "keywords": [
    "ecommerce",
    "ecommerce library",
    "library",
    "PHP library",
    "PHP ecommerce library"
  ],
  "require": {
    "php": ">=5.3.0"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\ExiguousEcommerce\\": "./src/"
    }
  },
  "replace": {
    "divineomega/exiguous-ecommerce": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.0-dev"
    }
  },
  "require-dev": {}
}
